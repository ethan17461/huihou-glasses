# 复制成 secrets.properties 再填写（这个文件不要提交、不要发群里）
# 编码用 UTF-8，名字可以直接写中文

# 阿里云百炼 API Key（北京地域）
DASHSCOPE_API_KEY=

# 一般不用改；用工作空间专属域名时改成 https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

QWEN_MODEL=qwen-plus

# 飞书群机器人 Webhook：建一个只有自己的群 → 设置 → 群机器人 → 添加自定义机器人
FEISHU_WEBHOOK=
# 机器人开了“签名校验”才填
FEISHU_SECRET=

# 戴眼镜的人在会上会被怎么称呼，用逗号隔开；用来判断哪些是“我的待办”
USER_NAMES=
